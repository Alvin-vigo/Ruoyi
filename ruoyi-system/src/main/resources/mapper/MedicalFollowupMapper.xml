<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.MedicalFollowupMapper">

    <resultMap type="MedicalFollowup" id="MedicalFollowupResult">
        <result property="followupId"       column="followup_id"       />
        <result property="patientId"        column="patient_id"        />
        <result property="patientName"      column="patient_name"      />
        <result property="followupDate"     column="followup_date"     />
        <result property="followupType"     column="followup_type"     />
        <result property="content"          column="content"           />
        <result property="nextFollowupDate" column="next_followup_date"/>
        <result property="status"           column="status"            />
        <result property="followupPerson"   column="followup_person"   />
        <result property="overdueDays"      column="overdue_days"      />
        <result property="createBy"         column="create_by"         />
        <result property="createTime"       column="create_time"       />
        <result property="updateBy"         column="update_by"         />
        <result property="updateTime"       column="update_time"       />
        <result property="remark"           column="remark"            />
    </resultMap>

    <sql id="selectMedicalFollowupVo">
        select f.followup_id, f.patient_id, p.patient_name, f.followup_date, f.followup_type,
               f.content, f.next_followup_date, f.status, f.followup_person,
               case when f.next_followup_date &lt; curdate() then datediff(curdate(), f.next_followup_date) else null end as overdue_days,
               f.create_by, f.create_time, f.update_by, f.update_time, f.remark
        from medical_followup f
        left join medical_patient p on f.patient_id = p.patient_id
    </sql>

    <sql id="queryFollowupWhere">
        <if test="patientId != null">
            AND f.patient_id = #{patientId}
        </if>
        <if test="patientName != null and patientName != ''">
            AND p.patient_name like concat('%', #{patientName}, '%')
        </if>
        <if test="followupType != null and followupType != ''">
            AND f.followup_type = #{followupType}
        </if>
        <if test="status != null and status != ''">
            AND f.status = #{status}
        </if>
        <if test="beginFollowupDate != null and beginFollowupDate != ''">
            AND f.followup_date &gt;= #{beginFollowupDate}
        </if>
        <if test="endFollowupDate != null and endFollowupDate != ''">
            AND f.followup_date &lt;= #{endFollowupDate}
        </if>
        <if test="quickFilter != null and quickFilter != ''">
            <choose>
                <when test="quickFilter == 'overdue'">
                    AND f.status = '0'
                    AND f.next_followup_date IS NOT NULL
                    AND f.next_followup_date &lt; curdate()
                </when>
                <when test="quickFilter == 'today'">
                    AND f.next_followup_date = curdate()
                </when>
                <when test="quickFilter == 'week'">
                    AND f.next_followup_date &gt;= curdate()
                    AND f.next_followup_date &lt;= date_add(curdate(), interval 7 day)
                </when>
                <when test="quickFilter == 'done'">
                    AND f.status = '1'
                </when>
            </choose>
        </if>
    </sql>

    <select id="selectMedicalFollowupList" parameterType="MedicalFollowup" resultMap="MedicalFollowupResult">
        <include refid="selectMedicalFollowupVo"/>
        <where>
            <include refid="queryFollowupWhere"/>
        </where>
        order by f.followup_date desc
    </select>

    <select id="selectMedicalFollowupById" parameterType="Long" resultMap="MedicalFollowupResult">
        <include refid="selectMedicalFollowupVo"/>
        where f.followup_id = #{followupId}
    </select>

    <select id="selectMedicalFollowupByPatientId" parameterType="Long" resultMap="MedicalFollowupResult">
        <include refid="selectMedicalFollowupVo"/>
        where f.patient_id = #{patientId}
        order by f.followup_date desc
    </select>

    <select id="selectOverdueFollowupList" resultMap="MedicalFollowupResult">
        <include refid="selectMedicalFollowupVo"/>
        where f.status = '0'
          and f.next_followup_date is not null
          and f.next_followup_date &lt; curdate()
        order by f.next_followup_date asc
    </select>

    <insert id="insertMedicalFollowup" parameterType="MedicalFollowup" useGeneratedKeys="true" keyProperty="followupId">
        insert into medical_followup
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="patientId != null">patient_id,</if>
            <if test="followupDate != null">followup_date,</if>
            <if test="followupType != null and followupType != ''">followup_type,</if>
            <if test="content != null and content != ''">content,</if>
            <if test="nextFollowupDate != null">next_followup_date,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="followupPerson != null and followupPerson != ''">followup_person,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            <if test="remark != null and remark != ''">remark,</if>
            create_time
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="patientId != null">#{patientId},</if>
            <if test="followupDate != null">#{followupDate},</if>
            <if test="followupType != null and followupType != ''">#{followupType},</if>
            <if test="content != null and content != ''">#{content},</if>
            <if test="nextFollowupDate != null">#{nextFollowupDate},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="followupPerson != null and followupPerson != ''">#{followupPerson},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
            sysdate()
        </trim>
    </insert>

    <update id="updateMedicalFollowup" parameterType="MedicalFollowup">
        update medical_followup
        <trim prefix="SET" suffixOverrides=",">
            <if test="patientId != null">patient_id = #{patientId},</if>
            <if test="followupDate != null">followup_date = #{followupDate},</if>
            <if test="followupType != null and followupType != ''">followup_type = #{followupType},</if>
            <if test="content != null">content = #{content},</if>
            <if test="nextFollowupDate != null">next_followup_date = #{nextFollowupDate},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="followupPerson != null and followupPerson != ''">followup_person = #{followupPerson},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            <if test="remark != null">remark = #{remark},</if>
            update_time = sysdate()
        </trim>
        where followup_id = #{followupId}
    </update>

    <delete id="deleteMedicalFollowupById" parameterType="Long">
        delete from medical_followup where followup_id = #{followupId}
    </delete>

    <delete id="deleteMedicalFollowupByIds" parameterType="String">
        delete from medical_followup where followup_id in
        <foreach item="followupId" collection="array" open="(" separator="," close=")">
            #{followupId}
        </foreach>
    </delete>

</mapper>
