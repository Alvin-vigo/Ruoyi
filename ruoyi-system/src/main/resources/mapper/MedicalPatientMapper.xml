<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.MedicalPatientMapper">

    <resultMap type="MedicalPatient" id="MedicalPatientResult">
        <result property="patientId"    column="patient_id"    />
        <result property="patientName"  column="patient_name"  />
        <result property="gender"       column="gender"       />
        <result property="birthDate"    column="birth_date"    />
        <result property="idCard"       column="id_card"       />
        <result property="phone"        column="phone"         />
        <result property="address"      column="address"       />
        <result property="bloodType"    column="blood_type"    />
        <result property="allergyHistory" column="allergy_history" />
        <result property="status"       column="status"        />
        <result property="createBy"     column="create_by"     />
        <result property="createTime"   column="create_time"   />
        <result property="updateBy"     column="update_by"     />
        <result property="updateTime"   column="update_time"   />
        <result property="remark"       column="remark"        />
    </resultMap>

    <sql id="selectMedicalPatientVo">
        select patient_id, patient_name, gender, birth_date, id_card, phone, address,
               blood_type, allergy_history, status, create_by, create_time, update_by, update_time, remark
        from medical_patient
    </sql>

    <select id="selectMedicalPatientList" parameterType="MedicalPatient" resultMap="MedicalPatientResult">
        <include refid="selectMedicalPatientVo"/>
        <where>
            <if test="patientName != null and patientName != ''">
                AND patient_name like concat('%', #{patientName}, '%')
            </if>
            <if test="gender != null and gender != ''">
                AND gender = #{gender}
            </if>
            <if test="phone != null and phone != ''">
                AND phone like concat('%', #{phone}, '%')
            </if>
            <if test="idCard != null and idCard != ''">
                AND id_card = #{idCard}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
        </where>
        order by create_time desc
    </select>

    <select id="selectMedicalPatientById" parameterType="Long" resultMap="MedicalPatientResult">
        <include refid="selectMedicalPatientVo"/>
        where patient_id = #{patientId}
    </select>

    <insert id="insertMedicalPatient" parameterType="MedicalPatient" useGeneratedKeys="true" keyProperty="patientId">
        insert into medical_patient
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="patientName != null and patientName != ''">patient_name,</if>
            <if test="gender != null and gender != ''">gender,</if>
            <if test="birthDate != null">birth_date,</if>
            <if test="idCard != null and idCard != ''">id_card,</if>
            <if test="phone != null and phone != ''">phone,</if>
            <if test="address != null and address != ''">address,</if>
            <if test="bloodType != null and bloodType != ''">blood_type,</if>
            <if test="allergyHistory != null and allergyHistory != ''">allergy_history,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            <if test="remark != null and remark != ''">remark,</if>
            create_time
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="patientName != null and patientName != ''">#{patientName},</if>
            <if test="gender != null and gender != ''">#{gender},</if>
            <if test="birthDate != null">#{birthDate},</if>
            <if test="idCard != null and idCard != ''">#{idCard},</if>
            <if test="phone != null and phone != ''">#{phone},</if>
            <if test="address != null and address != ''">#{address},</if>
            <if test="bloodType != null and bloodType != ''">#{bloodType},</if>
            <if test="allergyHistory != null and allergyHistory != ''">#{allergyHistory},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
            sysdate()
        </trim>
    </insert>

    <update id="updateMedicalPatient" parameterType="MedicalPatient">
        update medical_patient
        <trim prefix="SET" suffixOverrides=",">
            <if test="patientName != null and patientName != ''">patient_name = #{patientName},</if>
            <if test="gender != null and gender != ''">gender = #{gender},</if>
            <if test="birthDate != null">birth_date = #{birthDate},</if>
            <if test="idCard != null and idCard != ''">id_card = #{idCard},</if>
            <if test="phone != null and phone != ''">phone = #{phone},</if>
            <if test="address != null and address != ''">address = #{address},</if>
            <if test="bloodType != null and bloodType != ''">blood_type = #{bloodType},</if>
            <if test="allergyHistory != null and allergyHistory != ''">allergy_history = #{allergyHistory},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            <if test="remark != null">remark = #{remark},</if>
            update_time = sysdate()
        </trim>
        where patient_id = #{patientId}
    </update>

    <delete id="deleteMedicalPatientById" parameterType="Long">
        delete from medical_patient where patient_id = #{patientId}
    </delete>

    <delete id="deleteMedicalPatientByIds" parameterType="String">
        delete from medical_patient where patient_id in
        <foreach item="patientId" collection="array" open="(" separator="," close=")">
            #{patientId}
        </foreach>
    </delete>

</mapper>
