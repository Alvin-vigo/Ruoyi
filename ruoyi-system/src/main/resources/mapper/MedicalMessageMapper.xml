<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.MedicalMessageMapper">

    <resultMap type="MedicalMessage" id="MedicalMessageResult">
        <result property="messageId"   column="message_id"   />
        <result property="title"       column="title"        />
        <result property="content"     column="content"      />
        <result property="type"        column="type"         />
        <result property="receiver"    column="receiver"     />
        <result property="readStatus"  column="read_status"  />
        <result property="relatedId"   column="related_id"   />
        <result property="createTime"  column="create_time"  />
    </resultMap>

    <sql id="selectMedicalMessageVo">
        select message_id, title, content, type, receiver, read_status, related_id, create_time
        from medical_message
    </sql>

    <sql id="queryMessageWhere">
        <if test="title != null and title != ''">
            AND title like concat('%', #{title}, '%')
        </if>
        <if test="type != null and type != ''">
            AND type = #{type}
        </if>
        <if test="receiver != null and receiver != ''">
            AND receiver = #{receiver}
        </if>
        <if test="readStatus != null and readStatus != ''">
            AND read_status = #{readStatus}
        </if>
        <if test="beginTime != null and beginTime != ''">
            AND create_time &gt;= #{beginTime}
        </if>
        <if test="endTime != null and endTime != ''">
            AND create_time &lt;= #{endTime}
        </if>
    </sql>

    <insert id="insertMessage" parameterType="MedicalMessage" useGeneratedKeys="true" keyProperty="messageId">
        insert into medical_message
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="title != null and title != ''">title,</if>
            <if test="content != null and content != ''">content,</if>
            <if test="type != null and type != ''">type,</if>
            <if test="receiver != null and receiver != ''">receiver,</if>
            <if test="relatedId != null">related_id,</if>
            create_time
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="title != null and title != ''">#{title},</if>
            <if test="content != null and content != ''">#{content},</if>
            <if test="type != null and type != ''">#{type},</if>
            <if test="receiver != null and receiver != ''">#{receiver},</if>
            <if test="relatedId != null">#{relatedId},</if>
            sysdate()
        </trim>
    </insert>

    <select id="selectMessageList" parameterType="MedicalMessage" resultMap="MedicalMessageResult">
        <include refid="selectMedicalMessageVo"/>
        <where>
            <include refid="queryMessageWhere"/>
        </where>
        order by create_time desc
    </select>

    <select id="selectMessageById" parameterType="Long" resultMap="MedicalMessageResult">
        <include refid="selectMedicalMessageVo"/>
        where message_id = #{messageId}
    </select>

    <update id="updateMessage" parameterType="MedicalMessage">
        update medical_message
        <trim prefix="SET" suffixOverrides=",">
            <if test="readStatus != null and readStatus != ''">read_status = #{readStatus},</if>
            <if test="title != null and title != ''">title = #{title},</if>
            <if test="content != null and content != ''">content = #{content},</if>
        </trim>
        where message_id = #{messageId}
    </update>

    <select id="countUnreadByReceiver" parameterType="String" resultType="int">
        select count(1) from medical_message
        where receiver = #{receiver} and read_status = '0'
    </select>

    <update id="updateReadStatusByReceiver" parameterType="String">
        update medical_message set read_status = '1'
        where receiver = #{receiver} and read_status = '0'
    </update>

    <delete id="deleteMessageByIds" parameterType="String">
        delete from medical_message where message_id in
        <foreach item="messageId" collection="array" open="(" separator="," close=")">
            #{messageId}
        </foreach>
    </delete>

    <select id="countUnreadByTypeAndRelated" parameterType="MedicalMessage" resultType="int">
        select count(1) from medical_message
        where type = #{type} and related_id = #{relatedId} and receiver = #{receiver} and read_status = '0'
    </select>

    <select id="countByTypeAndRelated" parameterType="MedicalMessage" resultType="int">
        select count(1) from medical_message
        where type = #{type} and related_id = #{relatedId} and receiver = #{receiver}
    </select>

    <select id="selectLatestMessages" resultMap="MedicalMessageResult">
        <include refid="selectMedicalMessageVo"/>
        where receiver = #{param1}
        order by create_time desc
        limit #{param2}
    </select>

</mapper>
