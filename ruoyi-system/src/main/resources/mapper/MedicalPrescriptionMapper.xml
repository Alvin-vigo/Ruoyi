<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.MedicalPrescriptionMapper">

    <resultMap type="MedicalPrescription" id="PrescriptionResult">
        <result property="prescriptionId" column="prescription_id" />
        <result property="prescriptionNo" column="prescription_no" />
        <result property="registrationId" column="registration_id" />
        <result property="patientId" column="patient_id" />
        <result property="patientName" column="patient_name" />
        <result property="doctorName" column="doctor_name" />
        <result property="dept" column="dept" />
        <result property="diagnosis" column="diagnosis" />
        <result property="totalAmount" column="total_amount" />
        <result property="prescriptionStatus" column="prescription_status" />
        <result property="createBy" column="create_by" />
        <result property="createTime" column="create_time" />
        <result property="updateBy" column="update_by" />
        <result property="updateTime" column="update_time" />
        <result property="remark" column="remark" />
    </resultMap>

    <sql id="selectPrescriptionVo">
        select prescription_id, prescription_no, registration_id, patient_id, patient_name, doctor_name, dept, diagnosis, total_amount, prescription_status, create_by, create_time, update_by, update_time, remark from medical_prescription
    </sql>

    <select id="selectMedicalPrescriptionList" parameterType="MedicalPrescription" resultMap="PrescriptionResult">
        <include refid="selectPrescriptionVo"/>
        <where>
            <if test="prescriptionNo != null and prescriptionNo != ''">
                AND prescription_no like concat('%', #{prescriptionNo}, '%')
            </if>
            <if test="registrationId != null">AND registration_id = #{registrationId}</if>
            <if test="patientId != null">AND patient_id = #{patientId}</if>
            <if test="patientName != null and patientName != ''">
                AND patient_name like concat('%', #{patientName}, '%')
            </if>
            <if test="doctorName != null and doctorName != ''">
                AND doctor_name like concat('%', #{doctorName}, '%')
            </if>
            <if test="dept != null and dept != ''">
                AND dept like concat('%', #{dept}, '%')
            </if>
            <if test="diagnosis != null and diagnosis != ''">
                AND diagnosis like concat('%', #{diagnosis}, '%')
            </if>
            <if test="prescriptionStatus != null and prescriptionStatus != ''">
                AND prescription_status = #{prescriptionStatus}
            </if>
        </where>
        order by create_time desc
    </select>

    <select id="selectMedicalPrescriptionById" parameterType="Long" resultMap="PrescriptionResult">
        <include refid="selectPrescriptionVo"/>
        where prescription_id = #{prescriptionId}
    </select>

    <insert id="insertMedicalPrescription" parameterType="MedicalPrescription" useGeneratedKeys="true" keyProperty="prescriptionId">
        insert into medical_prescription
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="prescriptionNo != null and prescriptionNo != ''">prescription_no,</if>
            <if test="registrationId != null">registration_id,</if>
            <if test="patientId != null">patient_id,</if>
            <if test="patientName != null and patientName != ''">patient_name,</if>
            <if test="doctorName != null and doctorName != ''">doctor_name,</if>
            <if test="dept != null and dept != ''">dept,</if>
            <if test="diagnosis != null and diagnosis != ''">diagnosis,</if>
            <if test="totalAmount != null">total_amount,</if>
            <if test="prescriptionStatus != null and prescriptionStatus != ''">prescription_status,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            create_time,
            <if test="updateBy != null and updateBy != ''">update_by,</if>
            update_time,
            <if test="remark != null and remark != ''">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="prescriptionNo != null and prescriptionNo != ''">#{prescriptionNo},</if>
            <if test="registrationId != null">#{registrationId},</if>
            <if test="patientId != null">#{patientId},</if>
            <if test="patientName != null and patientName != ''">#{patientName},</if>
            <if test="doctorName != null and doctorName != ''">#{doctorName},</if>
            <if test="dept != null and dept != ''">#{dept},</if>
            <if test="diagnosis != null and diagnosis != ''">#{diagnosis},</if>
            <if test="totalAmount != null">#{totalAmount},</if>
            <if test="prescriptionStatus != null and prescriptionStatus != ''">#{prescriptionStatus},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            sysdate(),
            <if test="updateBy != null and updateBy != ''">#{updateBy},</if>
            sysdate(),
            <if test="remark != null and remark != ''">#{remark},</if>
        </trim>
    </insert>

    <update id="updateMedicalPrescription" parameterType="MedicalPrescription">
        update medical_prescription
        <trim prefix="SET" suffixOverrides=",">
            <if test="prescriptionNo != null and prescriptionNo != ''">prescription_no = #{prescriptionNo},</if>
            <if test="registrationId != null">registration_id = #{registrationId},</if>
            <if test="patientId != null">patient_id = #{patientId},</if>
            <if test="patientName != null and patientName != ''">patient_name = #{patientName},</if>
            <if test="doctorName != null and doctorName != ''">doctor_name = #{doctorName},</if>
            <if test="dept != null and dept != ''">dept = #{dept},</if>
            <if test="diagnosis != null and diagnosis != ''">diagnosis = #{diagnosis},</if>
            <if test="totalAmount != null">total_amount = #{totalAmount},</if>
            <if test="prescriptionStatus != null and prescriptionStatus != ''">prescription_status = #{prescriptionStatus},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate(),
            <if test="remark != null and remark != ''">remark = #{remark},</if>
        </trim>
        where prescription_id = #{prescriptionId}
    </update>

    <delete id="deleteMedicalPrescriptionById" parameterType="Long">
        delete from medical_prescription where prescription_id = #{prescriptionId}
    </delete>

    <delete id="deleteMedicalPrescriptionByIds" parameterType="Long">
        delete from medical_prescription where prescription_id in
        <foreach collection="array" item="prescriptionId" open="(" separator="," close=")">
            #{prescriptionId}
        </foreach>
    </delete>

    <update id="updatePrescriptionStatus">
        UPDATE medical_prescription SET prescription_status = #{status}, update_time = sysdate() WHERE prescription_id = #{id}
    </update>

</mapper>
