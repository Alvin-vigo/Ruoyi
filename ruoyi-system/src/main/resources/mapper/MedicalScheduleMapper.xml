<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.MedicalScheduleMapper">

    <resultMap type="MedicalSchedule" id="ScheduleResult">
        <result property="scheduleId" column="schedule_id" />
        <result property="dept" column="dept" />
        <result property="doctorName" column="doctor_name" />
        <result property="scheduleDate" column="schedule_date" />
        <result property="period" column="period" />
        <result property="totalNum" column="total_num" />
        <result property="usedNum" column="used_num" />
        <result property="status" column="status" />
        <result property="createBy" column="create_by" />
        <result property="createTime" column="create_time" />
        <result property="updateBy" column="update_by" />
        <result property="updateTime" column="update_time" />
        <result property="remark" column="remark" />
    </resultMap>

    <sql id="selectScheduleVo">
        select schedule_id, dept, doctor_name, schedule_date, period, total_num, used_num, status, create_by, create_time, update_by, update_time, remark from medical_schedule
    </sql>

    <select id="selectMedicalScheduleList" parameterType="MedicalSchedule" resultMap="ScheduleResult">
        <include refid="selectScheduleVo"/>
        <where>
            <if test="dept != null and dept != ''">
                AND dept like concat('%', #{dept}, '%')
            </if>
            <if test="doctorName != null and doctorName != ''">
                AND doctor_name like concat('%', #{doctorName}, '%')
            </if>
            <if test="scheduleDate != null">
                AND schedule_date = #{scheduleDate}
            </if>
            <if test="period != null and period != ''">
                AND period = #{period}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
        </where>
        order by create_time desc
    </select>

    <select id="selectMedicalScheduleById" parameterType="Long" resultMap="ScheduleResult">
        <include refid="selectScheduleVo"/>
        where schedule_id = #{scheduleId}
    </select>

    <insert id="insertMedicalSchedule" parameterType="MedicalSchedule" useGeneratedKeys="true" keyProperty="scheduleId">
        insert into medical_schedule
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="dept != null and dept != ''">dept,</if>
            <if test="doctorName != null and doctorName != ''">doctor_name,</if>
            <if test="scheduleDate != null">schedule_date,</if>
            <if test="period != null and period != ''">period,</if>
            <if test="totalNum != null">total_num,</if>
            <if test="usedNum != null">used_num,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            create_time,
            <if test="updateBy != null and updateBy != ''">update_by,</if>
            update_time,
            <if test="remark != null and remark != ''">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="dept != null and dept != ''">#{dept},</if>
            <if test="doctorName != null and doctorName != ''">#{doctorName},</if>
            <if test="scheduleDate != null">#{scheduleDate},</if>
            <if test="period != null and period != ''">#{period},</if>
            <if test="totalNum != null">#{totalNum},</if>
            <if test="usedNum != null">#{usedNum},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            sysdate(),
            <if test="updateBy != null and updateBy != ''">#{updateBy},</if>
            sysdate(),
            <if test="remark != null and remark != ''">#{remark},</if>
        </trim>
    </insert>

    <update id="updateMedicalSchedule" parameterType="MedicalSchedule">
        update medical_schedule
        <trim prefix="SET" suffixOverrides=",">
            <if test="dept != null and dept != ''">dept = #{dept},</if>
            <if test="doctorName != null and doctorName != ''">doctor_name = #{doctorName},</if>
            <if test="scheduleDate != null">schedule_date = #{scheduleDate},</if>
            <if test="period != null and period != ''">period = #{period},</if>
            <if test="totalNum != null">total_num = #{totalNum},</if>
            <if test="usedNum != null">used_num = #{usedNum},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate(),
            <if test="remark != null and remark != ''">remark = #{remark},</if>
        </trim>
        where schedule_id = #{scheduleId}
    </update>

    <delete id="deleteMedicalScheduleById" parameterType="Long">
        delete from medical_schedule where schedule_id = #{scheduleId}
    </delete>

    <delete id="deleteMedicalScheduleByIds" parameterType="Long">
        delete from medical_schedule where schedule_id in
        <foreach collection="array" item="scheduleId" open="(" separator="," close=")">
            #{scheduleId}
        </foreach>
    </delete>

    <update id="incrementUsed">
        UPDATE medical_schedule SET used_num = used_num + 1 WHERE schedule_id = #{scheduleId} AND used_num &lt; total_num
    </update>

    <update id="decrementUsed">
        UPDATE medical_schedule SET used_num = used_num - 1 WHERE schedule_id = #{scheduleId} AND used_num &gt; 0
    </update>

</mapper>
