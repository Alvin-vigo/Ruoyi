# ============================================================
# 若依医疗 · 环境变量模板
#
# 用法：复制为 .env 后填写，.env 不要提交到仓库（已在 .gitignore 中排除）
#   cp .env.example .env
# ============================================================

# 数据库 root 密码：compose 的 mysql 与 backend 共用同一变量
# 必填。首次部署请设置为你自己的口令，不要沿用本文件中的占位值。
DB_PASSWORD=changeme_before_deploy

# 后台超级管理员账号（RuoYi 框架内置，登录名为固定值）
# 默认口令由 sql/ 下的初始化脚本写入，首次登录后请立即修改。
# 本文件不提供口令，具体初始值见 doc/环境搭建清单.md 或咨询作者。
ADMIN_USERNAME=admin

# ---------- 以下通常无需修改，仅供覆盖默认值 ----------
# DB_HOST=mysql
# DB_PORT=3306
# REDIS_HOST=redis
# REDIS_PORT=6379
# AI_SERVICE_URL=http://ai:8000
